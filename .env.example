# Legal-Bengal Environment Configuration

# Groq API Key (Required - get one at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Redis Configuration (Optional - for chat persistence)
# If not set, chats will be saved to local files in data/chats/
UPSTASH_REDIS_URL=redis://localhost:6379

# Flask Secret Key (Change in production!)
SECRET_KEY=legal-bengal-secret-key-change-in-production

# OLLAMA Configuration (Optional - for local LLM support if needed)
# OLLAMA_BASE_URL=http://localhost:11434
